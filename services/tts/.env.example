# Copy to .env for local development. Never commit a filled-in copy.
# Every value here is server-side only — none of it reaches Flutter.

# ── Model ────────────────────────────────────────────────────────────────────
TTS_MODEL_ID=bertx18/magpie_tts_multilingual_357m
# Pin a commit so rebuilds are reproducible and the voice cannot shift.
# TTS_MODEL_REVISION=
# Part of every cache key. Bump it when the model or generation defaults change
# so previously generated audio is not reused under new settings.
TTS_MODEL_VERSION=magpie-357m-v1
TTS_DEVICE=cuda
TTS_DEFAULT_VOICE=Aria
TTS_APPLY_TN=true

# ── Limits ───────────────────────────────────────────────────────────────────
TTS_MAX_TEXT_LENGTH=500
TTS_MAX_CONCURRENCY=2
TTS_RATE_LIMIT_PER_MINUTE=30
TTS_REQUEST_TIMEOUT_SECONDS=60

# ── Audio ────────────────────────────────────────────────────────────────────
TTS_AUDIO_FORMAT=mp3
TTS_AUDIO_BITRATE=64k

# ── Cache ────────────────────────────────────────────────────────────────────
TTS_CACHE_ENABLED=true

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SECRET. Server only. Never ship this to the app.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tts-audio
# Optional: lets tokens be verified without a network call on legacy projects.
# SUPABASE_JWT_SECRET=
TTS_SIGNED_URL_TTL_SECONDS=3600

# ── Service-to-service ───────────────────────────────────────────────────────
# SECRET. Optional shared key for trusted server callers (e.g. a pre-warm job).
# Flutter authenticates as the user and must never receive this.
# TTS_API_KEY=

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Only needed for Flutter Web. Mobile clients do not use CORS.
TTS_CORS_ORIGINS=
LOG_LEVEL=INFO
